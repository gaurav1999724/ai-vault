# PostgreSQL connection for Prisma. Use a dedicated database user.
# Production builds prerender public pages, so this host must be reachable during `npm run build`.
# Hosted databases that sleep, such as Neon, need a longer connect timeout: add &connect_timeout=30&pool_timeout=30.
DATABASE_URL="postgresql://vault:change-me@127.0.0.1:5432/ai_creative_vault"

# Pepper for session token hashes. Use a long random string.
SESSION_PEPPER="replace-with-a-long-random-string"

# Public site URL used for canonical links and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First administrator. Used only by `npm run admin:create`.
# Leave blank in shared examples. Never commit a real password.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Vercel Blob. Required for media uploads on Vercel. The platform rejects app-server
# bodies over about 4.5 MB, so the browser sends the file straight to Blob.
# Connect a Blob store in the Vercel project and it sets BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=""

# Optional S3-compatible storage. When these are empty, and Blob is unset, uploads stay on local disk.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"

# Optional contact email. Messages are stored even when SMTP is unset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
CONTACT_TO=""
